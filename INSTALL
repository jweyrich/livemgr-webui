HOW TO SETUP IT FOR LOCAL TESTING
---------------------------------

# Clone this repository:
git clone https://github.com/jweyrich/livemgr-webui.git
cd livemgr-webui

# Install Python 3.10. Where the system doesn't package it, build it with pyenv:
#	pyenv install 3.10.22

# Create a virtual environment for our Python dependencies:
python3.10 -m venv env

# Activate it:
. ./activate.sh

# Check if the activation succeeeded - the printed path must reside within your cloned directory:
which python

# Upgrade pip - 26.2.1 is the latest release:
pip install pip==26.2.1

# Install swig - required by M2Crypto:
#
#	On Debian or Ubuntu:
#		sudo apt-get install swig
#	On RedHat, Fedora, or CentOS:
#		sudo yum install swig
# 	On Mac OS X using MacPorts:
#		sudo port install swig
#	On Mac OS X using HomeBrew:
#		brew install swig # no sudo, thanks!

# Install the MySQL or MariaDB client headers and mysql_config - required by mysqlclient:
#
#	On Debian or Ubuntu:
#		sudo apt-get install default-libmysqlclient-dev
#	On RedHat, Fedora, or CentOS:
#		sudo yum install mariadb-devel
#	On Mac OS X using HomeBrew:
#		brew install mysql-client

# Install our Python dependencies:
pip install -r requirements.txt

# Setup the MySQL or MariaDB database. Django 4.1 requires MySQL 5.7 or later,
# or MariaDB 10.3 or later: the containers and the tests use MariaDB 10.4.
mysql -u root -p -h localhost
> CREATE DATABASE livemgr;
> CREATE USER 'livemgr'@'localhost' IDENTIFIED BY 'livemgr';
> GRANT INDEX,ALTER,CREATE,SELECT,INSERT,UPDATE,DELETE ON livemgr.* TO 'livemgr'@'localhost';
> quit
mysql -u root -p -h localhost livemgr < bootstrap/db/create_mysql.sql

# Minify and concatenate media files (.css and .js):
make -C media all

# Create the web UI tables that have not already been created:
python webui/manage.py migrate --settings=settings_example

# Upgrading to Django 3.1? migrate also widens auth_user.first_name from 30
# to 150 characters, which the profile page now accepts. Until it runs, saving
# a longer first name fails.

# Upgrading to Django 4.0 behind a proxy? Form posts are now checked against
# the scheme and host the browser sent them to: see CSRF_FAILURE_VIEW in
# webui/settings.py, or every login lands on the "no cookie" page.

# Upgrading to Django 4.1? Accounts whose password is stored in the crypt
# format can no longer log in: see PASSWORD_HASHERS in webui/settings.py to find
# them. The logout link is now a form, styled by media/css/theme.css: rebuild
# the media files, or it shows as a plain button.

# Upgrading an install created by syncdb (Django < 1.7) that was never
# migrated? Django 1.8 no longer skips the migrations whose tables already
# exist, so mark them as applied instead:
#	python webui/manage.py migrate --fake-initial --settings=settings_example

# Test it! - After running the following command, navigate to http://127.0.0.1:8000/
python webui/manage.py runserver --settings=settings_example
